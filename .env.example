# Copy to .env and adjust. Every value is optional for local development.

DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production behind HTTPS: secure cookies, SSL redirect, HSTS
DJANGO_HTTPS=0
# e.g. https://poise.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Path to ffmpeg if it isn't on your PATH
FFMPEG_BINARY=ffmpeg
MAX_RECORDING_MB=200

# Contact form email (SMTP). Leave blank to print emails to the console.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
CONTACT_EMAIL=
